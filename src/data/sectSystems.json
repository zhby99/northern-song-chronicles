  "minorIntelTemplates": [
    {
      "title": "官道盐铁私运与绿林风声",
      "informantName": "老赵头",
      "informantTitle": "跑江湖老脚夫",
      "informantTalk": "“客官可是问最近官道上的风声？嘿，喝了这碗浊酒，老汉便与你透个实底……”",
      "summary": "近半月京东与河北官道私盐贩子颇为活跃，太行山几股绿林好汉正暗中截道，押镖行商须绕行大路或备足人手。"
    },
    {
      "title": "邻近州府粮价与茶马行情",
      "informantName": "钱算盘",
      "informantTitle": "行脚杂货掌柜",
      "informantTalk": "“小老儿刚从西边州府赶货回来，各州仓廪价目门儿清，客官问这作甚？”",
      "summary": "关中与河东军需征调趋紧，糙米与药草市价看涨两成，而江南丝茶经运河源源北上，牙行铺面正暗囤货源。"
    },
    {
      "title": "边关谍影与北辽游骑动向",
      "informantName": "焦老卒",
      "informantTitle": "退伍边军老校",
      "informantTalk": "“莫看俺腿脚不利索，边镇上的袍泽隔三岔五还捎信来呢……”",
      "summary": "近来有不少操燕云口音、扮作皮货商的汉子频繁出入北境榷场与州府酒肆，疑为北辽暗桩探听宋军换防虚实。"
    },
    {
      "title": "各派名宿近期行踪秘闻",
      "informantName": "白衣醒客",
      "informantTitle": "酒肆说书人",
      "informantTalk": "“茶馆酒楼本就是江湖耳目所在，这位少侠想打听哪路英雄的行踪？”",
      "summary": "听闻少林与丐帮近日各有高徒南下中原巡查，江南燕子坞与蜀中唐家堡亦似有信使往来，江湖怕是要起风波。"
    },
    {
      "title": "地方豪强与水陆帮会动向",
      "informantName": "吴老大",
      "informantTitle": "卸货老船工",
      "informantTalk": "“码头上的风吹草动，瞒不过俺们这些整日踩跳板讨生活的汉子。”",
      "summary": "运河沿岸几处水陆码头的帮派头目近来频繁聚首，似乎在重划地盘暗桩与护送规矩，各路门户宜早作防备。"
    },
    {
      "title": "药材奇珍与古刹异动传闻",
      "informantName": "葛半仙",
      "informantTitle": "云游草药郎中",
      "informantTalk": "“山野采药最讲究看天色闻风声，前日我在山麓歇脚时，倒真听见一件奇事……”",
      "summary": "近日深山野市偶有年份极佳的川芎、雪莲与陈年药酒现世，同时数座古寺名山夜半常有练功破风声，似有隐世高人现身。"
    }
  ]
}
