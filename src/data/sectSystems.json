  "kaifeng": {
    "investigationCases": [
      {
        "name": "官仓失窃案卷",
        "subType": "查核官粮私挪账目",
        "informantName": "王老记",
        "informantTitle": "卸粮老库丁",
        "informantTalk": "“官爷可算来了！上月十五夜里，小人亲眼见着三辆遮得严严实实的骡车打后门拉走了精米……”",
        "summary": "核实了官仓主簿暗中勾结粮商私挪赈灾粮的往来账簿与脚夫证词，案情已水落石出！"
      },
      {
        "name": "漕运私盐密账",
        "subType": "追查暗渡私盐渠道",
        "informantName": "陈水生",
        "informantTitle": "运河摆渡梢公",
        "informantTalk": "“嘘——小声些！每逢初一十五三更天，总有挂着假货旗的平底船在芦苇荡里交接盐包……”",
        "summary": "摸清了私盐船帮的暗桩暗号、卸货码头与接应商号，详绘成册以备六扇门收网！"
      },
      {
        "name": "京畿暗桩密信",
        "subType": "追索辽夏细作联络点",
        "informantName": "李茶博士",
        "informantTitle": "官道茶摊掌柜",
        "informantTalk": "“那几个操外乡口音的客商前脚刚走，桌缝里就塞了张带蜡印的字条，小老儿吓得没敢声张……”",
        "summary": "截获并拓印了暗桩接头密信与行踪规律，为开封府破获京畿谍网立下头功！"
      },
      {
        "name": "假钞私铸窝点",
        "subType": "暗访私铸皇祐通宝线索",
        "informantName": "刘铁锤",
        "informantTitle": "城郊废窑匠人",
        "informantTalk": "“官爷明鉴，后山那口废炭窑半夜常冒青烟，还有人拉着整车的废铜料往里送呢……”",
        "summary": "查明了城郊废窑私铸劣钱的炉灶位置与销赃路数，案卷证据确凿！"
      },
      {
        "name": "驿站盗马疑云",
        "subType": "追查军马失窃去向",
        "informantName": "赵马夫",
        "informantTitle": "递铺老马倌",
        "informantTalk": "“官爷问那几匹河西好马？蹄铁印子一路往西山岔道去了，半路上还换过一次假牌照……”",
        "summary": "顺藤摸瓜查清了盗马贼更换官印、销往黑市马贩的完整链条，线索已呈报府衙！"
      },
      {
        "name": "商旅失踪迷案",
        "subType": "暗查黑店谋财害命传闻",
        "informantName": "孙货郎",
        "informantTitle": "走街串巷货郎",
        "informantTalk": "“客官莫怪老汉多嘴，上月有两位苏杭绸缎商住进前头野店后，就再没见着影儿，只剩包袱皮漂在河沟里……”",
        "summary": "寻获了遇害商旅遗物与目击证言，锁定了作案黑店与赃物去向，圆满完成侦查！"
      }
    ],
