{
  "name": "northern-song-chronicles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:db": "node scripts/run_py.mjs scripts/compile_game_db.py",
    "normalize:docs": "node scripts/run_py.mjs scripts/compile_game_db.py --normalize-docs",
    "build": "tsc -b && vite build",
    "build:artifact": "node scripts/build_preview_artifact.mjs",
    "archive:masters": "node scripts/run_py.mjs scripts/archive_all_branch_assets.py",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
